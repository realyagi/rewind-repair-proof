# ---- REWIND environment (placeholders only — set real values in Coolify) ----
NODE_ENV=production
APP_URL=https://rewind.example.com
CORS_ORIGINS=https://rewind.example.com

# PostgreSQL (internal network only; DATABASE_URL is assembled in docker-compose)
POSTGRES_USER=rewind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rewind
DATABASE_URL=postgresql://rewind:change-me@postgres:5432/rewind

# Clerk — publishable key is browser-safe; secret key is server-only
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Optional: PEM public key (networkless JWT verification). Single line with \n escapes is OK.
CLERK_JWT_KEY=

# Vultr Serverless Inference — REQUIRED for repair-agent calls
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=
AI_TIMEOUT_MS=120000

# Google Gemini — OPTIONAL assistant features only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub OAuth App (private repo import). Callback: ${APP_URL}/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random 32+ char string used to encrypt stored GitHub tokens
ENCRYPTION_KEY=

# Storage: local | s3
STORAGE_PROVIDER=local
STORAGE_PATH=/app/storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Sandbox
SANDBOX_RUNTIME=docker-dind
SANDBOX_URL=http://sandbox:5000
SANDBOX_TOKEN=random-long-string
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_DISK_LIMIT=2g
SANDBOX_TIMEOUT_SECONDS=600
SANDBOX_INSTALL_NETWORK=bridge

# Live Preview — wildcard host on a DIFFERENT site than APP_URL (cookie/storage isolation).
# IP-only VPS example: PREVIEW_BASE_DOMAIN=139.84.166.173.nip.io  (preview URLs: <id>-<token>.139.84.166.173.nip.io)
# Domain example: PREVIEW_BASE_DOMAIN=rewind-preview.net with DNS "*.rewind-preview.net" -> server IP
PREVIEW_BASE_DOMAIN=
PREVIEW_SCHEME=http
PREVIEW_TTL_MINUTES=20
PREVIEW_MAX_PER_USER=1
PREVIEW_MAX_CONCURRENT=3
PREVIEW_MAX_TTL_SECONDS=3600
PREVIEW_CPU_LIMIT=0.5
PREVIEW_MEMORY_LIMIT=512m
PREVIEW_PIDS_LIMIT=128

# Limits
MAX_UPLOAD_MB=100
MAX_EXTRACTED_MB=500
MAX_REPAIR_RETRIES=3
MAX_CONCURRENT_REPAIR_RUNS=2
WORKSPACE_TTL_HOURS=24
